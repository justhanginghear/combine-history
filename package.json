{
  "name": "git-timelapse",
  "version": "1.0.0",
  "description": "Turn any git repo's history into one self-contained, browsable HTML changelog — as a CLI, a local GUI, or a standalone .exe.",
  "keywords": [
    "git",
    "changelog",
    "diff",
    "html",
    "diff2html",
    "history",
    "cli",
    "gui",
    "exe",
    "windows"
  ],
  "license": "MIT",
  "author": "hanging <justhanginghear@gmail.com>",
  "main": "./lib/render.js",
  "bin": {
    "git-timelapse": "./bin/git-timelapse.js"
  },
  "scripts": {
    "start": "node bin/git-timelapse.js",
    "gui": "node gui/server.js",
    "build:exe": "pkg gui/server.js --config package.json --targets node22-win-x64 --output dist/git-timelapse-gui.exe"
  },
  "pkg": {
    "scripts": ["lib/**/*.js", "gui/**/*.js"],
    "assets": []
  },
  "engines": {
    "node": ">=16"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justhanginghear/git-timelapse.git"
  },
  "bugs": {
    "url": "https://github.com/justhanginghear/git-timelapse/issues"
  },
  "homepage": "https://github.com/justhanginghear/git-timelapse#readme",
  "devDependencies": {
    "@yao-pkg/pkg": "^6.22.0"
  }
}
